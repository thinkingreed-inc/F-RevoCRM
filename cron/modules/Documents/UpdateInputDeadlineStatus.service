<?php
/**
 * 電子帳簿保存法対応: スキャナ保存の入力期限状態を更新する定期ジョブ
 *
 * 入力期限は日付の経過だけで「期限内 → 期限間近 → 期限超過」と変わるため、
 * 日付が変わったらできるだけ早く洗い替えたい。そのため15分ごとに起動する。
 *
 * ただし状態は基準日にしか依存しないので、同じ日に何度洗い替えても結果は同じ。
 * 実際に処理するのは日付が変わった最初の1回だけにして、残りは即座に終わらせる。
 * 期限日そのものは受領日の保存時に計算する。
 */

vimport('includes.runtime.Globals');
require_once 'modules/Documents/utils/DeadlineCalculator.php';

$result = Documents_DeadlineCalculator::updateStatusesIfDateChanged();
if ($result['skipped']) {
    echo "Documents input deadline status: skipped (already updated today)\n";
} else {
    echo "Documents input deadline status: updated {$result['updated']}\n";
}
