vimport('includes.runtime.Globals');
require_once 'include/Mcp/RateLimiter.php';
require_once 'include/Mcp/OAuthStorage.php';

$mcpRootDir = dirname(__FILE__, 4);
// 保持期間は mcp.php と同じシステム変数の設定に合わせる
$mcpRateWindow = Mcp_RateLimiter::parseLimitValue(Settings_Parameters_Record_Model::getParameterValue('MCP_RATE_LIMIT_WINDOW'), Mcp_RateLimiter::DEFAULT_WINDOW_SEC);
