{
    "name": "thinkingreed/frevocrm",
    "description": "F-RevoCRM",
    "type": "project",
    "license": "VPL",
    "authors": [
        {
            "name": "thinkingreed",
            "email": "info@thinkingreed.co.jp"
        }
    ],
    "autoload": {
        "files": ["includes/Loader.php"]
    },
    "minimum-stability": "stable",
    "require": {
        "ext-mysqli": "*",
        "ext-imap": "*",
        "smarty/smarty": "^4.3",
        "dg/rss-php": "^1.5",
        "ezyang/htmlpurifier": "^4.16",
        "tecnickcom/tcpdf": "^6.6",
        "monolog/monolog": "^2.9",
        "pragmarx/google2fa": "^8.0",
        "web-auth/webauthn-lib": "3.3.12",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "smalot/pdfparser": "^2.12",
        "symfony/http-foundation": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "friendsofphp/php-cs-fixer": "^3.86",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "FrevoCRM\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --testsuite Integration",
        "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "phpstan": "@php -d auto_prepend_file=phpstan-shim.php vendor/bin/phpstan analyse"
    }
}
